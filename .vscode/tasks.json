{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SAS: backend",
      "type": "shell",
      // Sobe db + postgrest junto, por causa do depends_on do compose.
      //
      // O printf existe porque o uvicorn dentro do container loga
      // `http://0.0.0.0:8000` — o endereço de dentro da rede do compose, que
      // não é clicável nem acessível do host. As URLs abaixo são as reais.
      "command": "printf '\\n  api        http://localhost:8000/docs\\n  postgrest  http://localhost:3000\\n\\n' && docker compose up api",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "sas",
        "reveal": "always",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Container sas-",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "SAS: frontend",
      "type": "shell",
      // O nginx não loga porta nenhuma na subida — daí o printf.
      "command": "printf '\\n  front  http://localhost:8080\\n\\n' && docker compose up web",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "sas",
        "reveal": "always",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Container sas-",
          "endsPattern": "start worker process"
        }
      }
    },
    {
      "label": "SAS: rodar tudo",
      "type": "shell",
      // Backend no compose (db + postgrest + api), front com o Vite NO HOST.
      //
      // Por que não `docker compose up` inteiro: nesta máquina o Docker não
      // consegue puxar `node:22-alpine` pro serviço `web` (credential helper
      // quebrado — mesmo sintoma do symlink do CLAUDE.md), e o `docker` do
      // PATH aponta pra um volume que não existe. Daí o binário absoluto e o
      // Vite fora do container. O proxy `/api` do vite.config.ts faz o browser
      // ver tudo em :8080, igual ao nginx em produção — é o que o login pelo
      // Canvas precisa (a redirect URI é http://localhost:8080/api/...).
      //
      // `trap` derruba a API ao encerrar a task: não sobra stack órfã.
      "command": "D=/Applications/Docker.app/Contents/Resources/bin/docker; $D compose up -d db postgrest api && printf '\\n  front      http://localhost:8080\\n  api        http://localhost:8000/docs\\n  postgrest  http://localhost:3000\\n\\n' && trap \"$D compose stop api\" EXIT && cd web && npx vite --port 8080",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "panel": "dedicated",
        "group": "sas",
        "reveal": "always",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Container sas-",
          "endsPattern": "Local:\\s+http://localhost:8080"
        }
      }
    },
    {
      "label": "SAS: db · aplicar migrations pendentes",
      "type": "shell",
      // O restart do postgrest vem no mesmo comando de propósito: ele lê o
      // schema uma vez, ao subir, então sem isso a coluna nova volta 404.
      "command": "docker compose run --rm migrate up && docker compose restart postgrest",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "panel": "dedicated",
        "group": "sas-db",
        "reveal": "always",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "SAS: db · downgrade (reverter última migration)",
      "type": "shell",
      "command": "docker compose run --rm migrate down && docker compose restart postgrest",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "panel": "dedicated",
        "group": "sas-db",
        "reveal": "always",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "SAS: db · limpar dados importados (TRUNCATE)",
      "type": "shell",
      "command": "docker compose run --rm migrate wipe-dados",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "panel": "dedicated",
        "group": "sas-db",
        "reveal": "always",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
