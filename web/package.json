{
  "name": "sas-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend do SAS — coordenação ITA/IME e área do aluno.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host --port 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src vite.config.ts",
    "lint:fix": "biome check --write src vite.config.ts",
    "lint:a11y": "biome lint --only=a11y src",
    "inventario": "GERAR_INVENTARIO=1 vitest run src/dados/aluno/inventario.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "katex": "^0.16.47",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
