{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-arquivo-editado.sh",
            "timeout": 30,
            "statusMessage": "Lint do arquivo editado"
          }
        ]
      }
    ]
  }
}
