# Configuração de produção do SAS no VPS.
#
# Copie para `.env` NO SERVIDOR (nunca commite o .env preenchido).
# O 02-deploy.sh gera este arquivo e sorteia os segredos marcados [gerado].
#
# Não reaproveite nada do api/.env da máquina de desenvolvimento: a troca de
# custódia é o momento certo de rotacionar (docs/15 §5).

# ─── Infra (lidas pelo docker-compose, não pela aplicação) ───────────────
TZ=America/Fortaleza
UVICORN_WORKERS=1              # NÃO aumente: travas do sync e do despachante
                               # são de processo (docs/14 §6.1)
POSTGRES_PASSWORD=             # [gerado]
POSTGREST_PASSWORD=            # [gerado]

# ─── Aplicação ──────────────────────────────────────────────────────────
# Sem estas duas a API se recusa a subir com APP_ENV=production.
JWT_SECRET_KEY=                # [gerado]
COORDENADOR_SENHA=             # [gerado] — anote antes do primeiro login
COORDENADOR_EMAIL=leonardobruno@aridesa.com

# Endereço público DA API — precisa incluir o prefixo /api.
#
# É o que monta o link de download de PDF entregue ao aluno. Sem o /api, a URL
# gerada é https://portalsas.online/arquivos/download?token=… , que não é a
# rota da API: cai no fallback de SPA do nginx e devolve o index.html com
# status 200. O browser recebe HTML no lugar do PDF, e um token adulterado
# também devolve 200 — falha que parece sucesso (docs/15 §Etapa 9).
API_BASE_URL=https://portalsas.online/api

# Sem CORS: front e API na mesma origem, atrás do mesmo nginx.
CORS_ALLOW_ORIGINS=

# ─── Backend de dados ───────────────────────────────────────────────────
# POSTGREST_URL e STORAGE_DIR vêm do compose. As variáveis SUPABASE_* PRECISAM
# ficar vazias: preenchidas, o storage.py tenta o bucket do Supabase, que não
# existe mais desde 13/08 (docs/14 §1).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Vazio = requisição sem Authorization, papel anônimo do PostgREST. Aceitável
# AQUI só porque o postgrest não tem porta publicada e é inalcançável de fora
# (docs/14 §5, item 1.3). Endurecer = PGRST_JWT_SECRET + token aqui.
POSTGREST_TOKEN=

# ─── Integrações ────────────────────────────────────────────────────────
# Sem chave, insights e chat degradam graciosamente (a UI esconde o painel).
OPENAI_API_KEY=
OPENAI_MODELO_INSIGHTS=gpt-4o-mini

# Sem token, o sync do Canvas não roda — é o que popula tudo (Etapa 4).
# Peça uma conta de serviço ao colégio; o token atual é pessoal e tem poder
# de escrita e de alteração de nota (docs/14 §6.6).
CANVAS_BASE_URL=https://aridesa.instructure.com
CANVAS_API_TOKEN=
CANVAS_ACCOUNT_ID=1
CANVAS_ANO_VIGENTE=
CANVAS_SYNC_LOOKBACK_MINUTOS=20

# Segredo do header X-Scheduler-Secret, usado pelos 4 jobs do cron (Etapa 6).
# Vazio faz as 4 rotas devolverem 503 — e nada avisa (docs/14 §5, Fase 3).
SCHEDULER_SECRET=              # [gerado]

# ─── E-mail — DESLIGADO (decisão de 21/08, docs/15 §2) ──────────────────
# Enquanto vazio: agendar com lembrete devolve 422 e a varredura da véspera
# é no-op. Nada é enviado.
AWS_SES_REGIAO=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
EMAIL_REMETENTE=
EMAIL_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=
SES_WEBHOOK_TOKEN=
LEMBRETE_TOKEN_SECRET=

# PRECISA ficar vazia em produção: preenchida, TODO e-mail é redirecionado
# para um endereço só — 873 mensagens com nome de aluno numa caixa (docs/14 §4).
EMAIL_DESTINATARIO_TESTE=

# Off por default. Ligar exige antes: teto >= audiência e validade no disparo
# (docs/14 §4.4).
LEMBRETE_ALUNO_ATIVO=false
LEMBRETE_ALUNO_HORA=18:00
EMAIL_ENVIOS_POR_SEGUNDO=5
LEMBRETES_ORCAMENTO_SEGUNDOS=240
EMAIL_TETO_DIARIO=150

STORAGE_BUCKET=sas-uploads     # ignorado no modo filesystem
